{
  "name": "study-english-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FRONTEND_ORIGIN": "https://english.3dowon.com",
    "ADDITIONAL_FRONTEND_ORIGIN": "https://study-english-api.qkryewon.workers.dev",
    "OPENAI_MODEL": "gpt-6-luna"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "study-english",
    "database_id": "5c92e600-8620-4706-88f3-a24e66e11326",
    "migrations_dir": "migrations"
  }],
  "assets": {"directory": "../dist-pages", "binding": "ASSETS", "run_worker_first": ["/api/*"]}
}
